---
import { PUBLIC_CF_WEB_ANALYTICS_TOKEN } from 'astro:env/server';
import '../styles/global.css';
// Inlined verbatim; astro.config.mjs hashes the same files for the Content-Security-Policy.
import themeInitScript from '../scripts/theme-init.js?raw';
import themeInitStyle from '../styles/theme-init.css?raw';

interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<meta charset="UTF-8" />
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>

<!-- Canonical -->
<link rel="canonical" href={canonicalURL.href} />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL.href} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<!-- Favicons -->
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#0B2150" />

{
    /*
        Cookieless Cloudflare Web Analytics (ADR 0002): no cookies, no local storage, no
        fingerprinting and no cross-site tracking, so no consent banner is needed. Only
        production builds set the token, so previews and local development load nothing.
    */
    PUBLIC_CF_WEB_ANALYTICS_TOKEN && (
        <script
            is:inline
            defer
            src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon={JSON.stringify({ token: PUBLIC_CF_WEB_ANALYTICS_TOKEN })}
        />
    )
}

<!-- Theme background and dark-mode class, applied before first paint (see the files). -->
<meta name="color-scheme" content="light dark" />
<style is:inline set:html={themeInitStyle} />
<script is:inline set:html={themeInitScript} />
