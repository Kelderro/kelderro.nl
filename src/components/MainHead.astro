---
import { PUBLIC_CF_WEB_ANALYTICS_TOKEN } from 'astro:env/server';
import '../styles/global.css';

interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<meta charset="UTF-8" />
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>

<!-- Canonical -->
<link rel="canonical" href={canonicalURL.href} />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL.href} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<!-- Favicons -->
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#0B2150" />

{
    /*
        Cookieless Cloudflare Web Analytics (ADR 0002): no cookies, no local storage, no
        fingerprinting and no cross-site tracking, so no consent banner is needed. Only
        production builds set the token, so previews and local development load nothing.
    */
    PUBLIC_CF_WEB_ANALYTICS_TOKEN && (
        <script
            is:inline
            defer
            src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon={JSON.stringify({ token: PUBLIC_CF_WEB_ANALYTICS_TOKEN })}
        />
    )
}

<!--
    Paint the page background before the external stylesheet arrives, so dark mode doesn't
    flash the browser's default white canvas. Colors mirror --gray-999 in global.css.
-->
<meta name="color-scheme" content="light dark" />
<style is:inline>
    :root {
        color-scheme: light;
        background-color: #ffffff;
    }
    :root.theme-dark {
        color-scheme: dark;
        background-color: #090b11;
    }
</style>

<script is:inline>
    // This code is inlined in the head to make dark mode instant & blocking.
    const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };
    const isDark = getThemePreference() === 'dark';
    document.documentElement.classList[isDark ? 'add' : 'remove']('theme-dark');
    // The preference is only stored when the visitor clicks the theme toggle
    // (ThemeToggle.astro), never automatically. See ADR 0002.
</script>
