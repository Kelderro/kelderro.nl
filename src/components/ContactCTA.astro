---
import Icon from './Icon.astro';
---

<section id="contact" class="consultation-footer">
    <div class="footer-container">
        <div class="status-pill">
            <span class="status-dot" aria-hidden="true"></span>
            Currently Engaged <span class="separator">•</span> Accepting Select Advisory & Strategic
            Engagements
        </div>

        <h2 class="footer-title">Ready to resolve your architectural bottlenecks?</h2>

        <p class="footer-description">
            I partner with select organizations to modernize legacy systems, scale engineering
            maturity, and align technical roadmaps with business goals.
        </p>

        <div class="footer-meta">
            <span>Netherlands Based</span>
            <span class="separator">•</span>
            <span class="highlight-meta">EU Citizen</span>
            <span class="separator">•</span>
            <span class="highlight-meta">UK Settled Status</span>
            <span class="separator">•</span>
            <span>Global Remote Engagements</span>
        </div>

        <div class="cta-group">
            <a
                href="https://linkedin.com/in/kelderro"
                class="btn-primary"
                target="_blank"
                rel="noopener noreferrer"
            >
                <Icon icon="linkedin-logo" size="1.1em" /> Connect on LinkedIn
            </a>
            <a href="/assets/rob-op-den-kelder-cv.pdf" download class="btn-secondary">
                <Icon icon="download-simple" size="1.1em" /> Download CV
            </a>
        </div>
        <div class="cta-links">
            <span class="cta-link-label">Ready to talk?</span>
            <a href="mailto:contact@kelderro.nl" class="cta-link">
                {' '}
                contact@kelderro.nl{' '}
            </a>
        </div>
    </div>
</section>

<style>
    .highlight-meta {
        color: var(--gray-0);
        font-weight: 500;
    }

    .consultation-footer {
        padding: 120px 20px;
        background: radial-gradient(
            circle at top,
            color-mix(in srgb, var(--accent-regular) 5%, transparent) 0%,
            transparent 70%
        );
        text-align: center;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 18px;
        border-radius: 100px;
        font-size: 0.8rem;
        color: var(--gray-200);
        margin-bottom: 2rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        border: 1px solid var(--gray-700);
        background: color-mix(in srgb, var(--gray-999) 80%, transparent);
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #4ade80;
        box-shadow: 0 0 6px #4ade80;
        animation: status-pulse 2.5s ease-in-out infinite;
        flex-shrink: 0;
    }

    @keyframes status-pulse {
        0%,
        100% {
            opacity: 1;
            box-shadow: 0 0 6px #4ade80;
        }
        50% {
            opacity: 0.45;
            box-shadow: 0 0 2px #4ade80;
        }
    }

    .footer-title {
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
    }

    .footer-description {
        font-size: 1.15rem;
        color: var(--gray-300);
        max-width: 600px;
        margin: 0 auto 3rem;
        line-height: 1.6;
    }

    .cta-group {
        padding-top: 2rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
    }

    .cta-links {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 1.25rem;
        flex-wrap: wrap;
    }

    .cta-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4em;
        color: var(--gray-400);
        text-decoration: none;
        font-size: var(--text-sm);
        transition: color 0.2s ease;
    }

    .cta-link:hover {
        color: var(--gray-0);
    }

    .cta-link-sep {
        color: var(--gray-700);
    }

    .cta-link-label {
        color: var(--gray-500);
        font-size: var(--text-sm);
    }

    .btn-primary {
        background: var(--accent-regular);
        color: var(--accent-text-over);
        padding: 18px 36px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px color-mix(in srgb, var(--accent-regular), transparent 60%);
    }

    .btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        background: transparent;
        color: var(--gray-200);
        padding: 18px 36px;
        border-radius: 8px;
        border: 1px solid var(--gray-700);
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-secondary:hover {
        border-color: var(--accent-regular);
        color: var(--gray-0);
        transform: translateY(-2px);
    }
</style>
