---
// Layout import - provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Component Imports
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';

// Page section components
import CareerTimeline from '../components/CareerTimeline.astro';
import ContactCTA from '../components/ContactCTA.astro';
import ImpactBand from '../components/ImpactBand.astro';
import Skills from '../components/Skills.astro';
import TechToolkit from '../components/TechToolkit.astro';
import { Image } from 'astro:assets';
import microsoftCertBadge from '../assets/microsoft-certified-expert-badge.svg';

const yearsOfExperience = new Date().getFullYear() - 2009;
const professionalTitle = 'Principal Engineer & Strategic Technology Consultant';
---

<BaseLayout
    title={`${professionalTitle}, Rob op den Kelder`}
    description="Principal engineer and strategic technology consultant helping enterprises make complex technology decisions, modernize critical platforms and scale engineering teams."
>
    <div class="stack gap-10 lg:gap-30">
        <section>
            <div class="wrapper stack gap-8 lg:gap-20">
                <header class="hero">
                    <Hero
                        title={professionalTitle}
                        tagline="I bridge business strategy and technical execution, helping enterprise organizations make complex technology decisions, modernize critical platforms, and scale engineering teams."
                        align="start"
                    >
                        <div class="roles">
                            <Pill>
                                <Icon icon="shield-check" size="1.33em" /> Strategic Technology
                            </Pill>
                            <Pill>
                                <Icon icon="rocket-launch" size="1.33em" /> Enterprise Architecture
                            </Pill>
                            <Pill>
                                <Icon icon="users-four" size="1.33em" /> Engineering Leadership
                            </Pill>
                        </div>
                    </Hero>
                </header>
                <div id="trustBar">
                    <span class="label">Strategic Impact at:</span>
                    <div class="company-list">
                        <span>Transavia</span>
                        <span class="separator">//</span>
                        <span>KPMG LLP (UK)</span>
                        <span class="separator">//</span>
                        <span>Royal Dutch Shell</span>
                        <span class="separator">//</span>
                        <span>CGI</span>
                    </div>
                </div>
                <ImpactBand yearsOfExperience={yearsOfExperience} />
                <section id="expertise" class="section">
                    <header class="section-header stack gap-2 lg:gap-4">
                        <!-- id="services" keeps older /#services links working -->
                        <h2 id="services">Areas of Expertise</h2>
                        <p>Where I deliver the most value for enterprise organizations.</p>
                    </header>
                    <div class="gallery">
                        <Skills yearsOfExperience={yearsOfExperience} />
                        <div class="cert-card-wrapper">
                            <a
                                href="https://learn.microsoft.com/api/credentials/share/en-us/RobKelder-0006/1D3FC9BEB76BCB26?sharingId=F604AD3A83C1F2D3"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="cert-card"
                            >
                                <div class="cert-badge-area">
                                    <Image
                                        src={microsoftCertBadge}
                                        alt="Microsoft Certified: Azure Solutions Architect Expert"
                                        format="svg"
                                    />
                                </div>
                                <div class="cert-info">
                                    <span class="cert-status">Active Certification</span>
                                    <h3 class="cert-title">
                                        Microsoft Certified: Azure Solutions Architect Expert
                                    </h3>
                                    <p class="cert-meta">Verified via Microsoft Learn</p>
                                </div>
                                <div class="cert-arrow">
                                    <svg viewBox="0 0 24 24" width="24" height="24">
                                        <path
                                            fill="currentColor"
                                            d="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"
                                        ></path>
                                    </svg>
                                </div>
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </section>
        <main class="wrapper stack gap-20 lg:gap-48">
            <!-- Experience: the career timeline, with case studies linked from their roles -->
            <section id="experience" class="with-background">
                <!-- id="engagements" keeps older /#engagements links working -->
                <div id="engagements">
                    <CareerTimeline />
                </div>
            </section>
            <section id="about">
                <h2>About Rob op den Kelder</h2>
                <div id="about-quote">
                    I've spent {yearsOfExperience}+ years in the trenches, from leading 40+ globally
                    distributed engineers at <strong>KPMG</strong> to modernizing legacy financial
                    systems for <strong>Transavia</strong>.
                </div>
                <p>
                    As a Strategic Technical Leader, I focus on the high-leverage decisions that
                    prevent technical debt and ensure long-term scalability. While I still code to
                    keep my saw sharp, my primary value lies in ensuring your architecture supports
                    your business goals with the same rigor I used to help secure{' '}
                    <strong>£150M+</strong> in enterprise contracts.
                </p>
                <h3 class="pillars-lead-in">
                    My approach is built on three pillars of experience:
                </h3>
                <section class="about-pillars">
                    <div class="pillars-grid">
                        <div class="pillar-item">
                            <div class="pillar-icon">
                                <span class="accent-bar"></span>
                            </div>
                            <h4>Enterprise Architecture</h4>
                            <p>
                                Designing scalable, event-driven microservice architectures for
                                global firms like <strong>KPMG</strong>.
                            </p>
                        </div>

                        <div class="pillar-item">
                            <div class="pillar-icon">
                                <span class="accent-bar"></span>
                            </div>
                            <h4>Legacy Modernization</h4>
                            <p>
                                Orchestrating cloud-native transformations to replace aging
                                infrastructure, such as the <strong>AS-400</strong> migration at{' '}
                                <strong>Transavia</strong>.
                            </p>
                        </div>

                        <div class="pillar-item">
                            <div class="pillar-icon">
                                <span class="accent-bar"></span>
                            </div>
                            <h4>Engineering Enablement</h4>
                            <p>
                                Scaling team maturity and delivery quality across DevOps, Data, and
                                QA disciplines.
                            </p>
                        </div>
                    </div>
                </section>
                <p class="pro-bono">
                    Outside client work, I'm a pro bono IT strategy advisor to non-technical leaders
                    at local non-profits and small businesses, from translating vendor proposals
                    into clear business guidance to leading IT procurement for an animal shelter.
                </p>
                <p class="name-origin">
                    <em lang="nl">Kelder</em> is Dutch for cellar: the foundation everything else is
                    built on. Fitting, since that's what I build.
                </p>
            </section>
        </main>

        <section id="technical-toolkit" class="wrapper stack gap-2 lg:gap-4">
            <header class="section-header stack gap-2 lg:gap-4">
                <h2>Technical Toolkit</h2>
                <p>Languages, platforms, and tools I use to deliver enterprise-grade solutions.</p>
            </header>
            <TechToolkit />
        </section>

        <ContactCTA />
    </div>
</BaseLayout>

<style>
    .hero-ctas {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
        flex-wrap: wrap;
    }

    .btn-download {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        background: transparent;
        color: var(--gray-200);
        padding: 0.6em 1.4em;
        border-radius: 8px;
        border: 1px solid var(--gray-700);
        text-decoration: none;
        font-weight: 600;
        font-size: var(--text-base);
        transition: all 0.3s ease;
    }

    .btn-download:hover {
        border-color: var(--accent-regular);
        color: var(--gray-0);
        transform: translateY(-2px);
    }

    @keyframes pulse {
        0% {
            opacity: 1;
        }
        50% {
            opacity: 0.4;
        }
        100% {
            opacity: 1;
        }
    }

    .cert-card-wrapper {
        margin-top: 3rem;
        display: flex;
        justify-content: center;
    }

    .cert-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.02); /* Very subtle fill */
        border: 1px solid var(--gray-800); /* The ONLY border */
        border-radius: 12px;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        max-width: 800px;
        min-width: 0;
    }

    @media (min-width: 50em) {
        .cert-card {
            gap: 2rem;
            padding: 2rem 2.5rem;
        }
    }

    /* On hover, we change the border color and add a subtle glow */
    .cert-card:hover {
        border-color: var(--accent-regular);
        transform: translateY(-2px);
        box-shadow: 0 10px 30px var(--gray-400);
    }

    .cert-badge-area {
        /* Fixed size: as a flex item it otherwise shrinks to make room for the title */
        flex-shrink: 0;
        width: 64px;
        height: auto;
        /* Soft glow behind the badge instead of a box */
        filter: drop-shadow(0px 0px 1.5rem rgba(0, 120, 212, 0.8));
    }

    @media (min-width: 50em) {
        .cert-badge-area {
            width: 90px;
        }
    }

    .cert-status {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--accent-regular);
        font-weight: 600;
    }

    .cert-title {
        font-size: 1.35rem;
        color: var(--gray-0);
        margin: 0.25rem 0;
    }

    .cert-meta {
        font-size: 0.85rem;
        color: var(--gray-400);
    }

    .cert-arrow {
        margin-left: auto;
        color: var(--gray-600);
    }

    .pillars-lead-in {
        margin-top: 3rem; /* Large gap to separate from narrative */
        margin-bottom: 1.5rem; /* Smaller gap to connect to the grid */
        font-size: 1.1rem;
        color: var(--gray-100);
        font-weight: 500;
        letter-spacing: 0.02em;
        /* Optional: A very thin left border or accent to make it pop */
        border-left: 2px solid var(--accent-regular);
        padding-left: 1rem;
    }

    .badge-icon {
        width: 60px; /* Keep it small and elegant */
        height: auto;
        filter: drop-shadow(0 0 10px rgba(0, 120, 212, 0.2)); /* Subtle Azure blue glow */
    }

    #about {
        --about-padding-block: 80px;
        padding: var(--about-padding-block) 20px;
        /* Nav jumps align the heading, not the padding above it, below the sticky header */
        scroll-margin-top: calc(-1 * var(--about-padding-block));
        width: 100%; /* Auto margins disable flex stretch; without this it sizes to its content */
        max-width: 1000px;
        margin: 0 auto;
        color: var(--gray-300);
    }

    #about-quote {
        position: relative;
        font-size: 1.85rem;
        line-height: 1.4;
        font-weight: 300;
        color: var(--gray-0);
        margin-bottom: 2.5rem;
        padding-top: 1.5rem; /* Space for the giant quote mark */
    }

    #about-quote::before {
        content: '“';
        position: absolute;
        top: -20px;
        left: -10px;
        font-size: 5rem;
        color: var(--accent-regular);
        opacity: 0.3; /* Subtle, not distracting */
        font-family: serif; /* Serifs look more "literary" and authoritative */
    }

    #about .pillars-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2.5rem;
        margin-top: 3rem;
    }

    #about .pillar-item h4 {
        color: var(--accent-regular);
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.1em;
        margin-bottom: 0.75rem;
    }

    #about .pillar-item p {
        font-size: 0.95rem;
        line-height: 1.6;
        opacity: 0.8;
    }

    #about .pro-bono {
        margin-top: 2.5rem;
        padding-left: 1rem;
        border-left: 2px solid var(--accent-regular);
        font-size: 0.95rem;
        line-height: 1.6;
        opacity: 0.8;
    }

    #about .name-origin {
        margin-top: 1rem;
        padding-left: calc(1rem + 2px);
        font-size: 0.875rem;
        line-height: 1.6;
        opacity: 0.85; /* Lowest value that meets WCAG AA (4.5:1) in light theme */
    }

    #trustBar {
        padding: 2.5rem 1rem;
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;

        background: linear-gradient(
            90deg,
            transparent 0%,
            rgba(255, 255, 255, 0.03) 50%,
            transparent 100%
        );
        border-top: 1px solid var(--gray-800);
        border-bottom: 1px solid var(--gray-800);
        text-align: center;
    }

    #trustBar a {
        text-decoration: none;
        color: var(--gray-0);
        transition: color 0.3s ease;
    }

    #trustBar a:hover {
        color: var(--accent-regular);
        cursor: pointer;
    }

    #trustBar .label {
        display: block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.25em;
        margin-bottom: 1.5rem;
        font-weight: 600;
    }

    #trustBar .company-list {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        flex-wrap: wrap;
        color: inherit; /* Bright white for the names */
        font-size: 1.25rem;
        font-weight: 500;
    }

    #trustBar .separator {
        opacity: 0.3;
    }

    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
    }

    .roles {
        display: none;
    }

    .hero-ctas {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1rem;
    }

    .hero img {
        object-fit: cover;
        object-position: top;
        border-radius: 1.5rem;
        box-shadow: var(--shadow-md);
    }

    @media (min-width: 50em) {
        .hero {
            display: block;
            grid-template-columns: 6fr 4fr;
            padding-inline: 2.5rem;
            gap: 3.75rem;
        }

        .roles {
            margin-top: 1.5rem;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .hero-ctas {
            justify-content: flex-start;
        }

        .hero img {
            aspect-ratio: 3 / 4;
            border-radius: 4.5rem;
            object-fit: cover;
        }
    }

    /* ====================================================== */

    .section {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2rem;
    }

    .with-background {
        position: relative;
    }

    .with-background::before {
        --hero-bg: var(--bg-image-subtle-2);

        content: '';
        position: absolute;
        pointer-events: none;
        left: 50%;
        width: 100vw;
        aspect-ratio: calc(2.25 / var(--bg-scale));
        top: 0;
        transform: translateY(-75%) translateX(-50%);
        background:
            url('/assets/backgrounds/noise.webp') top center/220px repeat,
            var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
            var(--gray-999);
        background-blend-mode: overlay, normal, normal, normal;
        mix-blend-mode: var(--bg-blend-mode);
        z-index: -1;
    }

    .with-background.bg-variant::before {
        --hero-bg: var(--bg-image-subtle-1);
    }

    .section-header {
        justify-self: center;
        text-align: center;
        max-width: 50ch;
        font-size: var(--text-md);
        color: var(--gray-300);
    }

    .section-header h2 {
        font-size: var(--text-2xl);
    }

    @media (min-width: 50em) {
        .section {
            grid-template-columns: repeat(4, 1fr);
            grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
            gap: 5rem;
        }

        .section-header {
            grid-area: header;
            font-size: var(--text-lg);
        }

        .section-header h2 {
            font-size: var(--text-4xl);
        }

        .gallery {
            grid-area: gallery;
        }
    }

    /* ====================================================== */

    .mention-card {
        display: flex;
        height: 7rem;
        justify-content: center;
        align-items: center;
        text-align: center;
        border: 1px solid var(--gray-800);
        border-radius: 1.5rem;
        color: var(--gray-300);
        background: var(--gradient-subtle);
        box-shadow: var(--shadow-sm);
    }

    @media (min-width: 50em) {
        .mention-card {
            border-radius: 1.5rem;
            height: 9.5rem;
        }
    }
</style>
