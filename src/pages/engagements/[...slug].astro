---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

import ContactCTA from '../../components/ContactCTA.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import { marked } from 'marked';
import { formatDuration } from '../../lib/duration';

export async function getStaticPaths() {
    const engagements = (await getCollection('engagement')).filter(
        (entry: CollectionEntry<'engagement'>) => entry.data.caseStudy
    );
    return engagements.map((entry: CollectionEntry<'engagement'>) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'engagement'> };
const { Content } = await render(entry);

function formatPeriod(startDate: Date, endDate: Date): string {
    const formatted = formatDuration(startDate, endDate);
    const duration = formatted ? ` · ${formatted}` : '';
    const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
    return `${fmt(startDate)} – ${fmt(endDate)}${duration}`;
}
---

<BaseLayout
    title={`${entry.data.position} | ${entry.data.employer}`}
    description={entry.data.description}
>
    <div class="stack gap-20">
        <div class="stack gap-15">
            <header>
                <div class="wrapper stack gap-2">
                    <nav class="breadcrumb" aria-label="Breadcrumb">
                        <ol>
                            <li>
                                <a href="/">Home</a>
                            </li>
                            <li>
                                <a href="/#experience">Experience</a>
                            </li>
                            <li aria-current="page">{entry.data.position}</li>
                        </ol>
                    </nav>
                    <Hero title={entry.data.position} align="start">
                        <div class="details">
                            <div class="tags">
                                {entry.data.tags.map((t: string) => (
                                    <Pill>{t}</Pill>
                                ))}
                            </div>
                            <p class="description">{entry.data.description}</p>
                        </div>
                    </Hero>

                    <div class="meta-card">
                        <div class="meta-item">
                            <Icon icon="office-building" size="1em" />
                            <a
                                href={entry.data.employerSite}
                                target="_blank"
                                rel="noopener noreferrer"
                                title={`Visit ${entry.data.employer} corporate website`}
                            >
                                {entry.data.employer}
                            </a>
                        </div>
                        {!entry.data.assignments && (
                            <div class="meta-item">
                                <Icon icon="calendar" size="1em" />
                                <span>
                                    {formatPeriod(entry.data.startDate, entry.data.endDate)}
                                </span>
                            </div>
                        )}
                        <div class="meta-item">
                            <Icon icon="map-pin" size="1em" />
                            <span>{entry.data.location}</span>
                        </div>
                        <div class="meta-item">
                            <Icon icon="list" size="1em" />
                            <span class="employment-badge">{entry.data.employment}</span>
                        </div>
                    </div>

                    {entry.data.assignments && (
                        <ol class="assignments" aria-label="Assignments">
                            {entry.data.assignments.map(a => (
                                <li>
                                    <span class="assignment-period">
                                        <Icon icon="calendar" size="1em" />
                                        {a.period}
                                    </span>
                                    <span class="assignment-name">{a.name}</span>
                                </li>
                            ))}
                        </ol>
                    )}

                    {entry.data.stats && (
                        <dl class="stats">
                            {entry.data.stats.map(s => (
                                <div class="stat">
                                    <dt>{s.label}</dt>
                                    <dd>{s.value}</dd>
                                </div>
                            ))}
                        </dl>
                    )}
                </div>
            </header>
            <main class="wrapper">
                <div class="stack content-area">
                    {entry.data.impact && (
                        <div class="impact-callout">
                            <h2 class="impact-title">Key Impact</h2>
                            <div class="impact-body" set:html={marked.parse(entry.data.impact)} />
                        </div>
                    )}
                    <div class="content">
                        <Content />
                    </div>
                </div>
            </main>
        </div>
        <ContactCTA />
    </div>
</BaseLayout>

<style>
    header {
        padding-bottom: 2.5rem;
        border-bottom: 1px solid var(--gray-800);
    }

    .breadcrumb ol {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: var(--text-sm);
        color: var(--gray-400);
    }

    .breadcrumb li:not(:last-child)::after {
        content: '/';
        margin-left: 0.4rem;
        color: var(--gray-600);
    }

    .breadcrumb a {
        color: var(--gray-400);
        text-decoration: none;
        transition: color var(--theme-transition);
    }

    .breadcrumb a:hover {
        color: var(--gray-0);
    }

    .breadcrumb [aria-current='page'] {
        color: var(--gray-200);
    }

    .details {
        display: flex;
        flex-direction: column;
        padding: 0.5rem;
        gap: 1.5rem;
        justify-content: space-between;
        align-items: center;
    }

    .tags {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .description {
        font-size: var(--text-lg);
        max-width: 54ch;
    }

    /* Metadata card */
    .meta-card {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 2rem;
        padding: 1rem 1.25rem;
        margin-top: 0.5rem;
        background: var(--gray-999_40);
        border: 1px solid var(--gray-800);
        border-left: 3px solid var(--accent-regular);
        border-radius: 0.75rem;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: var(--text-sm);
        color: var(--gray-300);
    }

    .meta-item a {
        color: var(--gray-200);
        text-decoration: none;
        transition: color var(--theme-transition);
    }

    .meta-item a:hover {
        color: var(--accent-regular);
    }

    .employment-badge {
        padding: 0.1rem 0.6rem;
        border: 1px solid var(--gray-700);
        border-radius: 999rem;
        font-size: 0.8rem;
        color: var(--gray-400);
    }

    /* Assignment list */
    .assignments {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        margin: 0.5rem 0 0;
        padding: 0;
    }

    .assignments li {
        flex: 1 1 12rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0.75rem 1rem;
        border: 1px solid var(--gray-800);
        border-top: 3px solid var(--accent-regular);
        border-radius: 0.5rem;
    }

    .assignment-period {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: var(--text-sm);
        color: var(--gray-400);
    }

    .assignment-name {
        color: var(--gray-200);
        font-weight: 600;
    }

    /* Stat strip */
    .stats {
        display: flex;
        flex-wrap: wrap;
        gap: 1px;
        margin: 0.5rem 0 0;
        background: var(--gray-800);
        border: 1px solid var(--gray-800);
        border-radius: 0.75rem;
        overflow: hidden;
    }

    .stat {
        flex: 1 1 9rem;
        display: flex;
        flex-direction: column-reverse;
        gap: 0.25rem;
        padding: 1rem 1.25rem;
        background: var(--gray-999);
    }

    .stat dd {
        margin: 0;
        font-family: var(--font-brand);
        font-size: var(--text-2xl);
        font-weight: 600;
        line-height: 1.1;
        color: var(--accent-regular);
    }

    .stat dt {
        font-size: var(--text-sm);
        color: var(--gray-300);
    }

    /* Impact callout */
    .impact-callout {
        padding: 1.25rem 1.5rem;
        background: var(--accent-overlay);
        border-left: 3px solid var(--accent-regular);
        border-radius: 0.5rem;
        max-width: 65ch;
        margin-inline: auto;
    }

    .impact-title {
        font-size: var(--text-sm);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent-regular);
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .impact-body {
        font-size: var(--text-md);
        color: var(--gray-200);
        line-height: 1.6;
    }

    /* MDX content */
    .content-area {
        gap: 2rem;
    }

    .content {
        max-width: 65ch;
        margin-inline: auto;
    }

    .content > :global(* + *) {
        margin-top: 1rem;
    }

    /* Style h5 headings used as MDX section titles */
    .content :global(h5) {
        margin: 2.5rem 0 0.75rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid var(--gray-800);
        font-size: var(--text-sm);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--accent-regular);
        font-weight: 600;
    }

    .content :global(h1),
    .content :global(h2),
    .content :global(h3),
    .content :global(h4) {
        margin: 1.5rem 0;
    }

    .content :global(img) {
        border-radius: 1.5rem;
        box-shadow: var(--shadow-sm);
        background: var(--gradient-subtle);
        border: 1px solid var(--gray-800);
    }

    .content :global(blockquote) {
        font-size: var(--text-lg);
        font-family: var(--font-brand);
        font-weight: 600;
        line-height: 1.1;
        padding-inline-start: 1.5rem;
        border-inline-start: 0.25rem solid var(--accent-dark);
        color: var(--gray-0);
    }

    .breadcrumb,
    .content :global(a) {
        text-decoration: 1px solid underline transparent;
        text-underline-offset: 0.25em;
        transition: text-decoration-color var(--theme-transition);
    }

    .content :global(a:hover),
    .content :global(a:focus) {
        text-decoration-color: currentColor;
    }

    @media (min-width: 50em) {
        .details {
            flex-direction: row;
            gap: 2.5rem;
        }

        .content :global(blockquote) {
            font-size: var(--text-2xl);
        }
    }
</style>
