# Security headers for every response served by Cloudflare Pages.
# Versioned and reviewed like code instead of configured in the Cloudflare
# dashboard (#154). CI compares the headers of each preview deployment with
# this file, and checks that production sends them (see ci.yml).
#
# Deliberately not set:
# - Expect-CT: obsolete; browsers no longer enforce Certificate Transparency
#   through this header.
# - X-XSS-Protection: deprecated. The legacy XSS filter it enabled could be
#   abused, and the Content-Security-Policy below replaces it.
# - Access-Control-Allow-Origin: Pages' default applies. The public site has
#   no cross-origin API to protect.

/*
  Content-Security-Policy: default-src 'self'; style-src 'unsafe-inline' 'self'; script-src 'self' 'unsafe-inline'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), midi=(), sync-xhr=(), microphone=(), camera=(), magnetometer=(), gyroscope=(), fullscreen=(self), payment=()
